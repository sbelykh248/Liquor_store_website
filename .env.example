# Copy this file to `.env.local` to run the site locally.
# None of these are required to run the site — without them the catalog
# serves the bundled prices/stock and the Stock Room runs in local demo mode.

# --- Firebase (live price + stock sync) ---------------------------------
# From the Firebase console: Project settings → General → "Your apps" (Web app).
# Same project the iOS app's FIREBASE_SETUP.md walks through — both clients
# read/write the same `products/{productId}` documents.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Stock Room demo mode -------------------------------------------------
# Only used while the Firebase vars above are empty. Lets you preview the
# manager dashboard without a real backend. Change this before sharing the
# site publicly.
NEXT_PUBLIC_DEMO_STOCK_ROOM_PASSCODE=juniors2026
